{
	"compatibility_date": "2026-06-09",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "kinoradar",
	"main": "./worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"triggers": {
		"crons": [
			"0 */4 * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "SHOWTIMES",
			"id": "6df48bd63e8842879f5910d30e2a29c0"
		}
	],
	"observability": {
		"enabled": true
	}
}