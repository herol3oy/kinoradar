---
import FilmList from "../components/FilmList.astro";
import { getTodayShows } from "../server/scraper";

const data = await getTodayShows();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Explore the repertuar of cinemas in Warsaw, Poland" />
		<meta name="generator" content={Astro.generator} />
		<title>KinoRadar</title>
	</head>
	<body>
		<main>
			<h1>KinoRadar</h1>
			<p>
				Today's films from Kinoteka, Kino Muranów, U-Jazdowski, Kino Wisła,
				Kino Atlantic, Kinoluna, Kino Kultura, Kino Amondo, Kino Elektronik and Kino Cytadela:
			</p>
			<FilmList initialData={data} />
		</main>
	</body>
</html>
