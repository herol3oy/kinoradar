---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import { getCachedSchedule } from "../server/kv";
import { getShowsReport } from "../server/scraper";
import { setCachedShows } from "../server/kv";
import App from "../components/App";

const today = new Date().toISOString().slice(0, 10);
let schedule = await getCachedSchedule(env.SHOWTIMES, today);
if (!schedule) {
  const result = await getShowsReport(today);
  schedule = await setCachedShows(env.SHOWTIMES, today, result.shows, result.failedCinemas);
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>KinoRadar - Today's Shows</title>
	</head>
	<body>
		<nav class="border-b border-retro-border px-3 py-3">
			<span
				class="text-2xl font-bold tracking-widest text-retro-magenta uppercase [text-shadow:0_0_10px_var(--color-retro-magenta),0_0_30px_var(--color-retro-magenta)]"
			>
				KINORADAR
			</span>
		</nav>
		<p class="text-gray-500 text-xs tracking-wider uppercase px-3 py-2 border-b border-retro-border">
			Today's films from Kinoteka, Muranów, U-Jazdowski, Wisła, Atlantic,
			Kinoluna, Kultura, Amondo, Elektronik, Cytadela, Iluzjon and
			Kinogram:
		</p>
		<main>
			<App
				shows={schedule.shows}
				updatedAt={schedule.updatedAt}
				failedCinemas={schedule.failedCinemas}
				client:load
			/>
		</main>
	</body>
</html>
