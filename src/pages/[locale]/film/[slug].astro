---
import { env } from "cloudflare:workers";
import HomePage from "../../../layouts/HomePage.astro";
import { locales, type Locale } from "../../../i18n/translations";
import { showsForFilm } from "../../../lib/film";
import { getCachedSchedule, setCachedShows } from "../../../server/kv";
import { getShowsReport } from "../../../server/scraper";

const localeParam = Astro.params.locale;
const locale = locales.includes(localeParam as Locale) ? localeParam as Locale : undefined;
const slug = Astro.params.slug;
if (!locale || !slug || !/^[\p{Letter}\p{Number}-]+$/u.test(slug)) return new Response("Not found", { status: 404 });

const today = new Date().toISOString().slice(0, 10);
const allowedDates = new Set(Array.from({ length: 7 }, (_, index) => {
  const date = new Date(`${today}T12:00:00Z`);
  date.setUTCDate(date.getUTCDate() + index);
  return date.toISOString().slice(0, 10);
}));
const requestedDate = Astro.url.searchParams.get("date");
const selectedDate = requestedDate && allowedDates.has(requestedDate) ? requestedDate : today;

let schedule = await getCachedSchedule(env.SHOWTIMES, selectedDate);
if (!schedule) {
  const report = await getShowsReport(selectedDate);
  schedule = await setCachedShows(env.SHOWTIMES, selectedDate, report.shows, report.failedCinemas);
}
const shows = showsForFilm(schedule.shows, slug);
const fallbackTitle = slug.split("-").filter(Boolean).map((word) => word[0]?.toUpperCase() + word.slice(1)).join(" ");
const film = {
  slug,
  title: shows[0]?.title ?? fallbackTitle,
  selectedDate,
  shows,
  failedCinemas: schedule.failedCinemas,
};
---

<HomePage locale={locale} film={film} />
