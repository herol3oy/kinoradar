---
---
<div class="controls-wrapper">
  <label for="film-date">[_SELECT_DATE]:</label>
  <select id="film-date"></select>
</div>

<div id="film-list">READY...</div>

<style is:global>
  /* =========================================
     Retro Digital Variables & Reset
     ========================================= */
  :root {
    --bg-color: #000000;
    --grid-box-bg: #0a0a0a;
    --border-color: #222222;
    --text-main: #e0e0e0;
    --text-muted: #666666;
    --neon-accent: #00ff66; /* Terminal green */
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    --color-kinoteka: #00ff66;
    --color-kinomuranow: #00ccff;
    --color-u-jazdowski: #ff44cc;
    --color-kinowisla: #ffcc00;
    --color-kinoatlantic: #ff6600;
    --color-kinoluna: #aa66ff;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-mono);
    padding: 2vw;
    min-height: 100vh;
    width: 100%;
  }

  /* Stark Retro Headings */
  h1 {
    font-size: 2rem;
    text-transform: uppercase;
    letter-spacing: -1px;
    color: var(--neon-accent);
    margin-bottom: 0.25rem;
  }

  body > p {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  /* =========================================
     Controls (Terminal Style)
     ========================================= */
  .controls-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px dashed var(--border-color);
    padding: 0.5rem 1rem;
    margin-bottom: 2.5rem;
    font-size: 0.85rem;
  }

  .controls-wrapper label {
    color: var(--neon-accent);
  }

  #film-date {
    background: #111;
    color: var(--text-main);
    border: 1px solid var(--border-color);
    font-family: var(--font-mono);
    padding: 0.25rem 0.5rem;
    outline: none;
    cursor: pointer;
  }

  #film-date option {
    background: #111;
    color: var(--text-main);
  }

  #film-date:focus {
    border-color: var(--neon-accent);
  }

  /* =========================================
     Cinema Columns Layout
     ========================================= */
  #film-list {
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  #film-list .columns {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  #film-list .cinema-column {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #film-list .cinema-header {
    font-size: 0.85rem;
    font-weight: bold;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* =========================================
     Film Card (within column)
     ========================================= */
  #film-list .film-card {
    background-color: var(--grid-box-bg);
    border: 1px solid var(--border-color);
    padding: 0.75rem;
    font-size: 0.8rem;
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    word-break: break-word;
  }

  #film-list .film-card:hover {
    box-shadow: 0 0 10px rgba(0, 255, 102, 0.15);
  }

  #film-list .film-title {
    font-weight: bold;
    font-size: 0.85rem;
  }

  #film-list .film-times {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Retro Action Link */
  #film-list .film-card a {
    text-decoration: none;
    color: #000000;
    background-color: var(--text-main);
    font-weight: bold;
    text-transform: uppercase;
    text-align: center;
    font-size: 0.7rem;
    padding: 0.35rem 0;
    display: block;
    width: 100%;
    margin-top: auto;
  }

  #film-list .film-card a:hover {
    background-color: var(--neon-accent);
  }
</style>

<script type="module">
  const container = document.getElementById('film-list');
  const dateSelect = document.getElementById('film-date');

  function formatDateValue(date) {
    return date.toISOString().slice(0, 10);
  }

  // Simplified format for tighter spaces
  function formatDateLabel(date) {
    return date.toLocaleDateString('pl-PL', {
      weekday: 'short',
      day: '2-digit',
      month: '2-digit',
    });
  }

  function buildDateOptions() {
    const today = new Date();
    for (let i = 0; i < 7; i += 1) {
      const date = new Date(today);
      date.setDate(today.getDate() + i);
      const option = document.createElement('option');
      option.value = formatDateValue(date);
      option.textContent = `${formatDateLabel(date)} [${option.value}]`;
      dateSelect.appendChild(option);
    }
    if (dateSelect.options.length > 0) {
      dateSelect.value = dateSelect.options[0].value;
    }
  }

  async function load(date) {
    if (!container) return;
    if (!date && dateSelect) {
      date = dateSelect.value;
    }
    container.textContent = '>> LOADING_DATA...';
    try {
      const params = new URLSearchParams({ date });
      const res = await fetch(`/api/today.json?${params.toString()}`, { cache: 'no-store' });
      const data = await res.json();
      if (!Array.isArray(data) || data.length === 0) {
        container.textContent = '>> NO_SHOWS_FOUND_FOR_THIS_DAY.';
        return;
      }

      const cinemas = ['Kinoteka', 'Kino Muranów', 'U-Jazdowski', 'Kino Wisła', 'Kino Atlantic', 'Kinoluna'];
      const groups = {};
      for (const c of cinemas) groups[c] = [];
      for (const s of data) {
        const cinema = s.cinema || s.source || 'UNK';
        if (!groups[cinema]) groups[cinema] = [];
        groups[cinema].push(s);
      }

      const columns = document.createElement('div');
      columns.className = 'columns';

      for (const cinema of cinemas) {
        const shows = groups[cinema] || [];
        const col = document.createElement('div');
        col.className = 'cinema-column';

        const colorVarName = { 'Kinoteka': '--color-kinoteka', 'Kino Muranów': '--color-kinomuranow', 'U-Jazdowski': '--color-u-jazdowski', 'Kino Wisła': '--color-kinowisla', 'Kino Atlantic': '--color-kinoatlantic', 'Kinoluna': '--color-kinoluna' }[cinema] || '--color-kinoteka';
        const colorVar = getComputedStyle(document.documentElement).getPropertyValue(colorVarName).trim() || '#888';

        const header = document.createElement('div');
        header.className = 'cinema-header';
        header.style.borderBottomColor = colorVar;
        header.style.color = colorVar;
        header.textContent = `● ${cinema} (${shows.length})`;

        col.appendChild(header);

        for (const s of shows) {
          const card = document.createElement('div');
          card.className = 'film-card';
          card.style.borderLeft = `3px solid ${colorVar}`;

          const title = document.createElement('div');
          title.className = 'film-title';
          title.textContent = s.title;

          const times = document.createElement('div');
          times.className = 'film-times';
          times.textContent = s.times && s.times.length ? `[${s.times.join(', ')}]` : '';

          card.appendChild(title);
          card.appendChild(times);

          if (s.link) {
            const a = document.createElement('a');
            a.href = s.link;
            a.textContent = 'LAUNCH_TICKET';
            a.target = '_blank';
            a.rel = 'noopener';
            card.appendChild(a);
          }

          col.appendChild(card);
        }

        columns.appendChild(col);
      }

      container.innerHTML = '';
      container.appendChild(columns);
    } catch (err) {
      container.textContent = '>> ERROR_FAILED_TO_LOAD.';
      console.error(err);
    }
  }

  if (dateSelect) {
    buildDateOptions();
    dateSelect.addEventListener('change', () => {
      load(dateSelect.value);
    });
    load(dateSelect.value);
  }
</script>