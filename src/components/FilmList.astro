---
import "./../global.css";

      const cinemas = ['Kinoteka', 'Kino Muranów', 'U-Jazdowski', 'Kino Wisła', 'Kino Atlantic', 'Kinoluna', 'Kino Kultura', 'Kino Amondo', 'Kino Elektronik', 'Kino Cytadela'];

const colorValues: Record<string, string> = {
  'Kinoteka': '#00ff66',
  'Kino Muranów': '#00ccff',
  'U-Jazdowski': '#ff44cc',
  'Kino Wisła': '#ffcc00',
  'Kino Atlantic': '#ff6600',
  'Kinoluna': '#aa66ff',
  'Kino Kultura': '#ff3366',
  'Kino Amondo': '#33ffcc',
  'Kino Elektronik': '#ff8844',
  'Kino Cytadela': '#ff4488',
};

interface Show {
  title: string;
  times?: string[];
  cinema?: string;
  link?: string;
  poster?: string;
  source?: string;
}

const { initialData } = Astro.props as { initialData?: Show[] | null };

const groups: Record<string, Show[]> = {};
for (const c of cinemas) groups[c] = [];
if (initialData && Array.isArray(initialData)) {
  for (const s of initialData) {
    const cinema = s.cinema || s.source || 'UNK';
    if (!groups[cinema]) groups[cinema] = [];
    groups[cinema].push(s);
  }
}
---

<div class="controls-wrapper">
  <label for="film-date">[_SELECT_DATE]:</label>
  <select id="film-date"></select>
</div>

<div id="film-list">
{
  initialData && initialData.length > 0 ? (
    <div class="columns">
      {cinemas.map(cinema => {
        const shows = groups[cinema] || [];
        const color = colorValues[cinema] || '#888';
        return (
          <div class="cinema-column">
            <div class="cinema-header" style={{ borderBottomColor: color, color }}>
              ● {cinema} ({shows.length})
            </div>
            <div class="film-scroll">
              {shows.map(s => (
                <div class="film-card" style={{ borderLeft: `3px solid ${color}` }}>
                  {s.poster && <img class="film-poster" src={s.poster} alt={s.title} loading="lazy" />}
                  <div class="film-title">{s.title}</div>
                  <div class="film-times">{s.times?.length ? `[${s.times.join(', ')}]` : ''}</div>
                  {s.link && <a href={s.link} target="_blank" rel="noopener">LAUNCH_TICKET</a>}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    'READY...'
  )
}
</div>

<script type="module">
  const container = document.getElementById('film-list');
  const dateSelect = document.getElementById('film-date');

  function formatDateValue(date) {
    return date.toISOString().slice(0, 10);
  }

  function formatDateLabel(date) {
    return date.toLocaleDateString('pl-PL', {
      weekday: 'short',
      day: '2-digit',
      month: '2-digit',
    });
  }

  function buildDateOptions() {
    const today = new Date();
    for (let i = 0; i < 7; i += 1) {
      const date = new Date(today);
      date.setDate(today.getDate() + i);
      const option = document.createElement('option');
      option.value = formatDateValue(date);
      option.textContent = `${formatDateLabel(date)} [${option.value}]`;
      dateSelect.appendChild(option);
    }
    if (dateSelect.options.length > 0) {
      dateSelect.value = dateSelect.options[0].value;
    }
  }

  async function load(date) {
    if (!container) return;
    if (!date && dateSelect) {
      date = dateSelect.value;
    }
    container.textContent = '>> LOADING_DATA...';
    try {
      const params = new URLSearchParams({ date });
      const res = await fetch(`/api/today.json?${params.toString()}`, { cache: 'no-store' });
      const data = await res.json();
      if (!Array.isArray(data) || data.length === 0) {
        container.textContent = '>> NO_SHOWS_FOUND_FOR_THIS_DAY.';
        return;
      }

const cinemas = ['Kinoteka', 'Kino Muranów', 'U-Jazdowski', 'Kino Wisła', 'Kino Atlantic', 'Kinoluna', 'Kino Kultura', 'Kino Amondo', 'Kino Elektronik', 'Kino Cytadela'];
      const groups = {};
      for (const c of cinemas) groups[c] = [];
      for (const s of data) {
        const cinema = s.cinema || s.source || 'UNK';
        if (!groups[cinema]) groups[cinema] = [];
        groups[cinema].push(s);
      }

      const columns = document.createElement('div');
      columns.className = 'columns';

      const colorValues = { 'Kinoteka': '#00ff66', 'Kino Muranów': '#00ccff', 'U-Jazdowski': '#ff44cc', 'Kino Wisła': '#ffcc00', 'Kino Atlantic': '#ff6600', 'Kinoluna': '#aa66ff', 'Kino Kultura': '#ff3366', 'Kino Amondo': '#33ffcc', 'Kino Elektronik': '#ff8844', 'Kino Cytadela': '#ff4488' };

      for (const cinema of cinemas) {
        const shows = groups[cinema] || [];
        const col = document.createElement('div');
        col.className = 'cinema-column';
        const color = colorValues[cinema] || '#888';

        const header = document.createElement('div');
        header.className = 'cinema-header';
        header.style.borderBottomColor = color;
        header.style.color = color;
        header.textContent = `● ${cinema} (${shows.length})`;

        col.appendChild(header);

        const filmScroll = document.createElement('div');
        filmScroll.className = 'film-scroll';

        for (const s of shows) {
          const card = document.createElement('div');
          card.className = 'film-card';
          card.style.borderLeft = `3px solid ${color}`;

          if (s.poster) {
            const img = document.createElement('img');
            img.src = s.poster;
            img.alt = s.title;
            img.className = 'film-poster';
            img.loading = 'lazy';
            card.appendChild(img);
          }

          const title = document.createElement('div');
          title.className = 'film-title';
          title.textContent = s.title;

          const times = document.createElement('div');
          times.className = 'film-times';
          times.textContent = s.times && s.times.length ? `[${s.times.join(', ')}]` : '';

          card.appendChild(title);
          card.appendChild(times);

          if (s.link) {
            const a = document.createElement('a');
            a.href = s.link;
            a.textContent = 'LAUNCH_TICKET';
            a.target = '_blank';
            a.rel = 'noopener';
            card.appendChild(a);
          }

          filmScroll.appendChild(card);
        }

        col.appendChild(filmScroll);
        columns.appendChild(col);
      }

      container.innerHTML = '';
      container.appendChild(columns);
    } catch (err) {
      container.textContent = '>> ERROR_FAILED_TO_LOAD.';
      console.error(err);
    }
  }

  if (dateSelect) {
    buildDateOptions();
    dateSelect.addEventListener('change', () => {
      load(dateSelect.value);
    });
    const hasInitialData = container && container.querySelector('.columns');
    if (!hasInitialData) {
      load(dateSelect.value);
    }
  }
</script>
