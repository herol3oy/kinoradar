---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import App from "../components/App";
import type { Locale } from "../i18n/translations";
import { translations } from "../i18n/translations";
import { getCachedSchedule, SCHEDULE_SCHEMA_VERSION } from "../server/kv";
import { setCachedShows } from "../server/kv";
import { getShowsReport } from "../server/scraper";
import { cinemas, type Cinema } from "../data/cinemas";
import FavoritesNavLink from "../components/FavoritesNavLink";
import FilmDetails from "../components/FilmDetails";
import type { Show } from "../lib/normalize";
import { warsawDate, warsawDateRange, warsawTimeMinutes } from "../lib/warsaw-date";
import { parseShowFilters, type ShowFilterState } from "../lib/show-filter-params";
import { buildPopularScreenings, type PopularScreeningItem } from "../lib/popular-screenings";
import { getAvailablePopularFilms } from "../server/filmweb";
import UpcomingReleases from "../components/UpcomingReleases";
import type { ReleasePageData } from "../lib/releases";
import { RiCalendarEventLine, RiRadarLine } from "@remixicon/react";
import { ClientRouter } from "astro:transitions";

interface Props {
  locale: Locale;
  cinema?: Cinema;
  favoritesPage?: boolean;
  film?: { slug: string; title: string; selectedDate: string; shows: Show[]; failedCinemas: string[] };
  releaseCalendar?: {
    initialPage: ReleasePageData;
    initialQuery: string;
    initialGenreId: number | null;
    loadError: boolean;
  };
}

const { locale, cinema, favoritesPage = false, film, releaseCalendar } = Astro.props;
const t = translations[locale];
const otherLocale: Locale = locale === "pl" ? "en" : "pl";
const releasesPath = locale === "pl" ? "/pl/premiery/" : "/en/releases/";
const otherReleasesPath = otherLocale === "pl" ? "/pl/premiery/" : "/en/releases/";
const pagePath = releaseCalendar ? releasesPath : film ? `/${locale}/film/${film.slug}/` : favoritesPage ? `/${locale}/favorites/` : cinema ? `/${locale}/kino/${cinema.slug}/` : `/${locale}/`;
const isSchedulePage = !favoritesPage && !film && !releaseCalendar && !cinema;
const sharedQuery = (favoritesPage || film || releaseCalendar || isSchedulePage) ? Astro.url.search : "";
const otherPath = releaseCalendar ? `${otherReleasesPath}${sharedQuery}` : film ? `/${otherLocale}/film/${film.slug}/${sharedQuery}` : favoritesPage ? `/${otherLocale}/favorites/${sharedQuery}` : cinema ? `/${otherLocale}/kino/${cinema.slug}/` : `/${otherLocale}/${sharedQuery}`;
const canonicalUrl = new URL(pagePath, Astro.site);
const polishUrl = new URL(releaseCalendar ? "/pl/premiery/" : film ? `/pl/film/${film.slug}/` : favoritesPage ? "/pl/favorites/" : cinema ? `/pl/kino/${cinema.slug}/` : "/pl/", Astro.site);
const englishUrl = new URL(releaseCalendar ? "/en/releases/" : film ? `/en/film/${film.slug}/` : favoritesPage ? "/en/favorites/" : cinema ? `/en/kino/${cinema.slug}/` : "/en/", Astro.site);
const title = releaseCalendar
  ? `${t.releases.title} ${t.releases.accent} | KinoRadar`
  : film
  ? `${film.title} — ${t.filmPage.allScreenings} | KinoRadar`
  : favoritesPage
  ? `${t.favorites.title} | KinoRadar`
  : cinema
  ? `${cinema.label} — ${t.cinemaPage.schedule} | KinoRadar`
  : t.meta.title;
const description = releaseCalendar
  ? t.releases.description
  : film
  ? `${film.title}: ${t.filmPage.description}`
  : favoritesPage
  ? t.favorites.description
  : cinema
  ? `${cinema.label}: ${t.cinemaPage.description}`
  : t.meta.description;
const socialImage = new URL("/og-image.png", Astro.site);
const jsonLd = releaseCalendar
  ? {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: title,
      description,
      url: canonicalUrl.toString(),
      inLanguage: locale,
      isPartOf: { "@type": "WebSite", name: "KinoRadar", url: new URL(`/${locale}/`, Astro.site).toString() },
    }
  : film
  ? [
      { "@context": "https://schema.org", "@type": "WebPage", name: title, description, url: canonicalUrl.toString(), inLanguage: locale },
      { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
        { "@type": "ListItem", position: 1, name: t.cinemaPage.home, item: new URL(`/${locale}/`, Astro.site).toString() },
        { "@type": "ListItem", position: 2, name: film.title, item: canonicalUrl.toString() },
      ] },
    ]
  : cinema
  ? [
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description,
        url: canonicalUrl.toString(),
        isPartOf: { "@type": "WebSite", name: "KinoRadar", url: new URL(`/${locale}/`, Astro.site).toString() },
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: t.cinemaPage.home, item: new URL(`/${locale}/`, Astro.site).toString() },
          { "@type": "ListItem", position: 2, name: cinema.label, item: canonicalUrl.toString() },
        ],
      },
    ]
  : {
      "@context": "https://schema.org",
      "@graph": [
        { "@type": "WebSite", name: "KinoRadar", url: canonicalUrl.toString(), inLanguage: locale },
        { "@type": "Organization", name: "KinoRadar", url: canonicalUrl.toString(), logo: new URL("/favicon.svg", Astro.site).toString() },
      ],
    };
const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");

const today = warsawDate();
const initialFilters: ShowFilterState = parseShowFilters(Astro.url.searchParams, today, warsawDateRange(7));
const scheduleDate = initialFilters.date;
let schedule = { schemaVersion: SCHEDULE_SCHEMA_VERSION, shows: [], updatedAt: null, failedCinemas: [] } as Awaited<ReturnType<typeof setCachedShows>>;
let popularItems: PopularScreeningItem[] = [];
if (!favoritesPage && !film && !releaseCalendar) {
  const cachedSchedule = await getCachedSchedule(env.SHOWTIMES, scheduleDate);
  if (cachedSchedule) {
    schedule = cachedSchedule;
  } else {
    const result = await getShowsReport(scheduleDate);
    schedule = await setCachedShows(env.SHOWTIMES, scheduleDate, result.shows, result.failedCinemas);
  }

  try {
    const films = await getAvailablePopularFilms(env.SHOWTIMES);
    popularItems = buildPopularScreenings(films, schedule.shows, warsawTimeMinutes());
  } catch (error) {
    console.warn(JSON.stringify({
      message: "popular screenings unavailable",
      errorMessage: error instanceof Error ? error.message : String(error),
    }));
    popularItems = [];
  }
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {favoritesPage && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl" href={polishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={polishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KinoRadar" />
    <meta property="og:locale" content={locale === "pl" ? "pl_PL" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={serializedJsonLd} />
    <ClientRouter />
    <script is:inline>
      const themeQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const syncTheme = () => document.documentElement.classList.toggle("dark", themeQuery.matches);
      syncTheme();
      themeQuery.addEventListener("change", syncTheme);
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-border/80 bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/70">
      <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <a href={`/${locale}/`} class="group flex min-w-0 items-center gap-3" aria-label={t.header.home}>
          <span class="grid size-9 shrink-0 place-items-center border border-primary/40 bg-primary/10 text-primary transition-colors group-hover:bg-primary/20">
            <RiRadarLine size={20} aria-hidden="true" />
          </span>
          <span class="grid min-w-0">
            <span class="truncate font-heading text-base font-semibold tracking-tight">Kino<span class="text-primary">Radar</span></span>
            <span class="hidden truncate text-xs text-muted-foreground sm:block">{t.header.tagline}</span>
          </span>
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <a
            href={releasesPath}
            aria-current={releaseCalendar ? "page" : undefined}
            class:list={["inline-flex h-8 items-center gap-2 px-2.5 text-xs font-medium transition-colors hover:bg-muted hover:text-foreground", releaseCalendar ? "bg-muted text-foreground" : "text-muted-foreground"]}
          >
            <RiCalendarEventLine size={16} aria-hidden="true" />
            <span class="hidden sm:inline">{t.releases.nav}</span>
          </a>
          <FavoritesNavLink locale={locale} client:load />
          <span class="hidden items-center gap-2 px-2 text-xs text-muted-foreground md:flex">
            <span class="size-1.5 rounded-full bg-primary"></span>
            {t.header.online}
          </span>
          <nav aria-label={t.header.language} class="flex border border-border">
            <a href={`${pagePath}${sharedQuery}`} aria-current="page" class="bg-primary px-2.5 py-1.5 text-xs font-medium text-primary-foreground">{locale}</a>
            <a href={otherPath} data-locale-switch hreflang={otherLocale} lang={otherLocale} class="px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">{otherLocale}</a>
          </nav>
        </div>
      </div>
    </header>
    <main class="pb-16 pt-8 sm:pt-10" transition:animate="fade">
      {(cinema || favoritesPage || film || releaseCalendar) && (
        <nav aria-label="Breadcrumb" class="mx-auto mb-6 flex max-w-7xl items-center gap-2 px-4 text-xs text-muted-foreground sm:px-6 lg:px-8">
          <a href={`/${locale}/`} class="transition-colors hover:text-foreground">{t.cinemaPage.home}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="truncate text-foreground">{releaseCalendar ? t.releases.nav : film?.title ?? (favoritesPage ? t.favorites.nav : cinema?.label)}</span>
        </nav>
      )}
      {releaseCalendar ? (
        <UpcomingReleases
          locale={locale}
          initialPage={releaseCalendar.initialPage}
          initialQuery={releaseCalendar.initialQuery}
          initialGenreId={releaseCalendar.initialGenreId}
          loadError={releaseCalendar.loadError}
          client:load
        />
      ) : film ? (
        <FilmDetails locale={locale} slug={film.slug} title={film.title} selectedDate={film.selectedDate} shows={film.shows} failedCinemas={film.failedCinemas} client:load />
      ) : (
        <App locale={locale} cinema={cinema} favoritesPage={favoritesPage} shows={schedule.shows} updatedAt={schedule.updatedAt} failedCinemas={schedule.failedCinemas} initialFilters={initialFilters} popularItems={popularItems} client:load />
      )}
    </main>
    <footer class="border-t border-border px-4 py-10">
      <nav aria-label={t.cinemaPage.cinemas} class="mx-auto mb-8 flex max-w-5xl flex-wrap justify-center gap-x-5 gap-y-3 text-xs text-muted-foreground">
        {cinemas.map((item) => (
          <a href={`/${locale}/kino/${item.slug}/`} class="transition-colors hover:text-foreground">{item.label}</a>
        ))}
      </nav>
      {releaseCalendar && (
        <div class="mx-auto mb-8 flex max-w-xl flex-col items-center gap-3 border-y border-border py-5 text-center">
          <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer" aria-label="The Movie Database">
            <img
              src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_square_2-d537fb228cf3ded904ef09b136fe3fec72548ebc1fea3fbbd1ad9e36364db38b.svg"
              alt="TMDB"
              width="512"
              height="369"
              class="h-10 w-auto"
            />
          </a>
          <p class="max-w-md text-xs leading-5 text-muted-foreground">{t.releases.attribution}</p>
        </div>
      )}
      <p class="text-center text-xs text-muted-foreground">{t.footer}</p>
    </footer>
  </body>
</html>
